# -*- mode: gitignore; -*-
# Emacs common temp/backup files
*~
\#*\#
.\#*
*.elc
auto-save-list/
tramp
.emacs.desktop
.emacs.desktop.lock
.eshell/history
.eshell/lastdir
.network-security.data
.session

# Org-mode generated files
.org-id-locations
*_archive

# Temp files from checkers (Flycheck/Flymake etc.)
*_flymake.*
flycheck_*.el

# ELPA packages (downloaded; do not commit!)
elpa/
eln-cache/
elpa-*/
eln-cache-*/

# Emacs backup dir (if you configure backups)
emacs-backup/
backups/

# EMMS (music player) cache
emms/
emms-cache
emms-history
emms-streams

# etc/ extras/ themes/ var/ etc. (usually user-specific or generated)
etc/
var/

# Doom Emacs specific (if your .local exists)
.local/
.local*/

# Miscellaneous
*.cache*
*.log
.tree-sitter/
tree-sitter/
.dap-breakpoints
lisp/private.el

# Vulpea note database (machine state, do not commit)
vulpea.db
vulpea.db-shm
vulpea.db-wal
